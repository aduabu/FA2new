# FrontAccounting Enterprise Platform — Environment Template Example

PORT_WEB=3000
PORT_API=8080
PORT_DB=3306
PORT_REDIS=6379

DB_HOST=mysql
DB_PORT=3306
DB_NAME=frontacct
DB_USER=fa_user
DB_PASS=fa_password
DB_ROOT_PASS=fa_root_password
DB_PREFIX=0_

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRATION_HOURS=8

APP_ENV=development
APP_DEBUG=true
APP_VERSION=v1.0.0-RC1
